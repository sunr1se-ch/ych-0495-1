{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --import-map=import_map.json main.ts",
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --import-map=import_map.json --watch main.ts",
    "seed": "deno run --allow-read --allow-write --allow-env --import-map=import_map.json tools/seed.ts",
    "generate": "deno run --allow-read --allow-write --allow-env --import-map=import_map.json tools/generate_readings.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "importMap": "./import_map.json"
}
